<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time tool: dumps PKHeX.Core's encounter / form / evolution data as JSON for tools/build-data.
    Always build through run.mjs (Release, with an artifacts path) so that nothing is written into the PKHeX tree.
    Debug builds of PKHeX.Core return different location strings, so Debug is rejected at startup.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pelagix.Extractor</RootNamespace>
    <AssemblyName>Pelagix.Extractor</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PKHeX\PKHeX.Core\PKHeX.Core.csproj" />
  </ItemGroup>

</Project>
